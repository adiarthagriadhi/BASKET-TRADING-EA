# Salin ke .env lalu sesuaikan
DATABASE_URL=sqlite:///./gateway.db
ADMIN_TOKEN=ganti-dengan-token-admin-yang-panjang-dan-acak
ENVIRONMENT=sandbox
PUBLIC_BASE_URL=http://localhost:8000
PAYMENT_EXPIRY_MINUTES=60

# ShopeePay (isi setelah onboarding; kosongkan = pakai simulator)
SHOPEEPAY_CLIENT_ID=
SHOPEEPAY_SECRET_KEY=
SHOPEEPAY_MERCHANT_EXT_ID=
SHOPEEPAY_STORE_EXT_ID=
# UAT: https://api.uat.wallet.airpay.co.id  |  Produksi: https://api.wallet.airpay.co.id
SHOPEEPAY_BASE_URL=https://api.uat.wallet.airpay.co.id
SHOPEEPAY_PLATFORM_TYPE=mweb
